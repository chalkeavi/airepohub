# Copy to .env.jobs (git-ignored) and fill in. Used by `pnpm writer` / `pnpm jobs <job>` on your computer.
# Never commit the real file: the service-role key can change anything in the database.

# --- Database (required) ---
SUPABASE_URL=https://ugykphnasjjtmzeygwoq.supabase.co
# Supabase dashboard → Project Settings → API keys → secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub (strongly recommended: 5,000 requests/hour instead of 60) ---
# github.com → Settings → Developer settings → Fine-grained token, public repositories read-only, no extra permissions
GITHUB_TOKEN=

# --- Model (required) ---
# anthropic = Claude API.  openai = any OpenAI-compatible server (OpenAI, Ollama, LM Studio, OpenRouter, Groq, Gemini...)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Anthropic/OpenAI/OpenRouter key. Leave empty for a local server that doesn't need one.
LLM_API_KEY=
# Only for LLM_PROVIDER=openai. Examples:
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
#   OpenAI:    https://api.openai.com/v1 (default)
LLM_BASE_URL=

# --- Optional ---
# LLM_MAX_TOKENS=16000       # answer size limit (default 16000; thinking models count their reasoning against it)
# WRITER_LIMIT=20            # pages to publish per run
# WRITER_MIN_STARS=500       # skip smaller repos
# WRITER_README_CHARS=30000  # README characters sent to the model (lower it for small local models)
