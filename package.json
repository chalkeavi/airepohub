{
  "name": "airepohub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed:generate": "node --experimental-strip-types --no-warnings scripts/generate-seed.ts",
    "jobs": "node --experimental-strip-types --no-warnings scripts/run-jobs.ts",
    "writer": "node --experimental-strip-types --no-warnings scripts/run-jobs.ts write",
    "cf:build": "node scripts/check-deploy-env.mjs && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/check-deploy-env.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:check-env": "node scripts/check-deploy-env.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.18",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.3.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@10.28.0"
}
